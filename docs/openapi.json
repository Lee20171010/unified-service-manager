  "components": {
    "schemas": {
      "BackupInput": {
        "properties": {
          "client": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Client"
          },
          "scenario": {
            "type": "string",
            "enum": [
              "normal",
              "long",
              "fail"
            ],
            "title": "Scenario",
            "default": "normal"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "client"
        ],
        "title": "BackupInput"
      },
      "BindingInput": {
        "properties": {
          "parent": {
            "type": "string",
            "title": "Parent"
          },
          "register_command": {
            "type": "string",
            "maxLength": 16384,
            "minLength": 1,
            "title": "Register Command"
          },
          "unregister_command": {
            "type": "string",
            "maxLength": 16384,
            "minLength": 1,
            "title": "Unregister Command"
          },
          "verify_command": {
            "type": "string",
            "maxLength": 16384,
            "title": "Verify Command",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "parent",
          "register_command",
          "unregister_command"
        ],
        "title": "BindingInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HostInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "title": "Name"
          },
          "address": {
            "type": "string",
            "maxLength": 253,
            "minLength": 1,
            "title": "Address"
          },
          "port": {
            "type": "integer",
            "maximum": 65535.0,
            "minimum": 1.0,
            "title": "Port",
            "default": 22
          },
          "username": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_-]{0,31}$",
            "title": "Username",
            "default": "unified"
          },
          "key": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-][a-zA-Z0-9_.-]{0,63}$",
            "title": "Key",
            "default": "id_ed25519"
          },
          "platform": {
            "type": "string",
            "maxLength": 60,
            "title": "Platform",
            "default": "Linux"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "address"
        ],
        "title": "HostInput"
      },
      "Operation": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "refresh",
              "start",
              "stop",
              "restart",
              "upgrade"
            ],
            "title": "Action"
          },
          "scenario": {
            "type": "string",
            "enum": [
              "normal",
              "long",
              "fail"
            ],
            "title": "Scenario",
            "default": "normal"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action"
        ],
        "title": "Operation"
      },
      "PluginDocument": {
        "properties": {
          "manifest": {
            "additionalProperties": true,
            "type": "object",
            "title": "Manifest"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "manifest"
        ],
        "title": "PluginDocument"
      },
      "PluginOperation": {
        "properties": {
          "action": {
